"Schulden: liquides Vermögen plus Immobilien und Rentenverträge minus "
"Darlehen, {money}."

#: report/summary.py
msgid "The name of the scenario."
msgstr "Der Name des Szenarios."

#: report/summary.py
msgid "Typical shortfall"
msgstr "Typischer Fehlbetrag"

#: report/summary.py
#, python-brace-format
msgid ""
